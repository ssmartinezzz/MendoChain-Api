# Copy to .env. ./setup.sh creates it and fills every empty value with a local default.

# Django
# Leave empty to let ./setup.sh generate a random key. Always set a unique one in production.
SECRET_KEY=
# true only for local development.
DEBUG=true
# Comma-separated host names the API answers to.
ALLOWED_HOSTS=localhost,127.0.0.1
# Level for the api loggers (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Database (PostgreSQL)
# Either set DATABASE_URL, which takes precedence...
# DATABASE_URL=postgres://user:password@host:5432/mendochain
# DATABASE_SSL_REQUIRE=true
# ...or the individual variables. ./setup.sh starts a local container with these values.
DB_NAME=mendochain
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Algorand (TestNet account used to sign traceability transactions)
# Without them, recording a movement returns 502 ledger_unavailable.
PRIVATE_KEY=
WALLET_ADD=
# Optional: node and receiver. Defaults: public TestNet node and the project receiver address.
# ALGOD_ADDRESS=https://testnet-api.algonode.cloud
# ALGOD_TOKEN=
# ALGORAND_RECEIVER=
